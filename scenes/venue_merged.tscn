[sub_resource type="GDScript" id="GDScript_yuhmj"]
script/source = "extends RefCounted


func run(npc:CharacterBody2D,player:CharacterBody2D):
	# DIALOGGGG
	var garbage_mode = npc.get_parent().get_node(\"GarbageMode\")
	if garbage_mode != null:
		garbage_mode.start()
"

[sub_resource type="GDScript" id="GDScript_ad8vj"]
script/source = "func run(npc:CharacterBody2D,player:CharacterBody2D):
	if npc.has_meta(\"collectingwater_started\"):
		return
	var rhythm_mode = npc.get_parent().get_node_or_null(\"CollectWaterMode\")
	if rhythm_mode == null:
		return
	npc.set_meta(\"collectingwater_started\", true)
	rhythm_mode.start()
	npc.queue_free()
	Globals.friends += 1
"

[sub_resource type="GDScript" id="GDScript_4tm60"]
script/source = "extends RefCounted

func run(npc: CharacterBody2D, player: CharacterBody2D):
	var lit = npc.get_parent().get_node_or_null(\"LitCampfire\")
	if lit != null:
		lit.start()
"

[sub_resource type="GDScript" id="GDScript_sy5xd"]
script/source = "extends RefCounted


func run(npc:CharacterBody2D,player:CharacterBody2D):
	if npc.has_meta(\"debugging_started\"):
		return
	var debugging_mode = npc.get_parent().get_node_or_null(\"DebuggingMode\")
	if debugging_mode == null:
		return
	npc.set_meta(\"debugging_started\", true)
	debugging_mode.start()
	npc.queue_free() 
	Globals.friends += 1
"

[sub_resource type="GDScript" id="GDScript_clf25"]
script/source = "extends RefCounted
# Flowery interaction script
func run(npc:CharacterBody2D,_player:CharacterBody2D):
	# Get deltarune flowers Node2D and start
	var mode = npc.get_parent().get_node(\"DeltaruneFlowers\")
	if mode:
		mode.start()
"

[sub_resource type="GDScript" id="GDScript_hxsln"]
script/source = "extends RefCounted


func run(npc:CharacterBody2D,player:CharacterBody2D):
	if npc.has_meta(\"rhythm_started\"):
		return
	var rhythm_mode = npc.get_parent().get_node_or_null(\"RhythmMode\")
	if rhythm_mode == null:
		return
	npc.set_meta(\"rhythm_started\", true)
	rhythm_mode.start()
	npc.queue_free()
	Globals.friends += 1
"

[sub_resource type="GDScript" id="GDScript_qhtkb"]
script/source = "extends RefCounted

func run(npc:CharacterBody2D,player:CharacterBody2D)->void:
	var mode = npc.get_parent().get_node(\"CaffeineMode\")
	if mode!=null:
		mode.start()
"

[sub_resource type="GDScript" id="GDScript_36q3d"]
script/source = "extends RefCounted

func run(npc:CharacterBody2D,_player:CharacterBody2D):
	var mode = npc.get_parent().get_node(\"Typerace\")
	if mode:
		mode.start(npc)
"

