; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="asasd"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Globals="*uid://boj1de3u456do"
DebuggingQuestions="*uid://dllop2di7nf5l"
BetterTerrain="*uid://dx3fwj5y8pvnq"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/better-tile-editor/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg")

[global_group]

navigation_polygon_source_geometry_group=""

[gui]

common/auto_focus_strategy=1

[input]

